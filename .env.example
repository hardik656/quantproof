# Copy to .env and fill in. Never commit real values.

# Persistence: leave empty to use JSON files in QP_STATE_DIR (default /tmp)
DATABASE_URL=
# DATABASE_URL=postgresql+psycopg://app:app@localhost:5432/app
QP_STATE_DIR=/tmp

# AI fix-plan providers (tried in order Groq -> Anthropic -> OpenAI)
GROQ_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Payments
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
PADDLE_PRICE_LITE=
PADDLE_PRICE_REPORT=
PADDLE_PRICE_PORTFOLIO=
PADDLE_PRICE_PRO=
# Optional: checkout page (approved domain, includes Paddle.js); default https://quantproof.net/
PADDLE_CHECKOUT_URL=
# Webhook IP allowlist: log (default) | enforce | off. Signature is always required.
PADDLE_IP_ALLOWLIST=log
# Trusted proxies that append to X-Forwarded-For. Render counts as 1.
# PADDLE_TRUSTED_PROXY_HOPS is still read if TRUSTED_PROXY_HOPS is unset.
TRUSTED_PROXY_HOPS=1
PADDLE_TRUSTED_PROXY_HOPS=1

# Set to 1 to publish /docs, /redoc and /openapi.json. Leave unset in production.
ENABLE_API_DOCS=
# Required to call /debug/reset-limit and /debug/token. Leave unset to disable both.
DEBUG_ADMIN_TOKEN=

# Dev-only override token for paid features (leave empty in production)
TEST_REPORT_TOKEN=
DEV_TOKEN=
ADMIN_TOKEN=
